---
import Layout from '../layouts/Layout.astro';

const waitlist = 'mailto:help@ctrl-cv.io?subject=ctrl-cv%20Pro%20waitlist';
const sales = 'mailto:help@ctrl-cv.io?subject=ctrl-cv%20Enterprise';
---

<Layout
  title="ctrl-cv Pricing: 30 Free Copies, Then $4 a Month"
  description="Try ctrl-cv with 30 free copies, no card needed. Standard for moving text between AI apps, Pro for keeping it, Enterprise for teams."
>
  <section class="pricing-head">
    <h1>Pricing</h1>
    <p class="lede"><strong>Start free. Pay only if you keep using it.</strong> Every account gets 30 free copies, with no card and no time limit.</p>
  </section>

  <ol class="trial-steps" aria-label="How paying works">
    <li><span>1</span>Sign in with Google</li>
    <li><span>2</span>Use 30 copies free</li>
    <li><span>3</span>Subscribe only if you want more</li>
  </ol>

  <div class="billing-toggle" role="group" aria-label="Billing period" hidden>
    <button type="button" data-show="month" aria-pressed="true">Monthly</button>
    <button type="button" data-show="year" aria-pressed="false">Yearly</button>
  </div>

  <section class="plans" aria-label="Plans" data-cycle="month">
    <article class="plan">
      <h2>Standard</h2>
      <p class="price">Free<span> to start</span></p>
      <p class="price-note"><span data-cycle="month"><strong>$4 / month</strong> after 30 free copies.</span><span data-cycle="year"><strong>$36 / year</strong> after 30 free copies, $3 a month.</span></p>
      <a class="button" href="https://app.ctrl-cv.io/login">Try free, no card</a>
      <p class="trial-note">You won't be asked to pay until your 30 free copies are used, and only if you choose to subscribe.</p>
      <ul>
        <li>Copy and paste across your AI apps</li>
        <li>Browse your recent clips from your AI</li>
        <li>Clips kept for 30 days</li>
        <li>Up to 10 million characters</li>
        <li>See, add, and delete clips on the web</li>
        <li>Markdown formatting on the web</li>
        <li>Send to me, 20 times a day, with the exact text attached</li>
      </ul>
    </article>

    <article class="plan">
      <h2>Pro <span class="soon">Coming soon</span></h2>
      <p class="price" data-cycle="month">$7<span> / month</span></p>
      <p class="price" data-cycle="year">$60<span> / year</span></p>
      <p class="price-note"><span data-cycle="month">Billed monthly.</span><span data-cycle="year">Billed yearly, about $5 a month.</span></p>
      <a class="button ghost" href={waitlist}>Join the waitlist</a>
      <p class="includes">Everything in Standard, plus:</p>
      <ul>
        <li>Clips kept for 1 year</li>
        <li>Pin clips so they never expire</li>
        <li>Up to 100 million characters</li>
        <li>Name a clip and paste it by name</li>
        <li>Search your clips on the web</li>
        <li>Edit clips on the web</li>
        <li>Share a clip with a link</li>
      </ul>
    </article>

    <article class="plan">
      <h2>Enterprise</h2>
      <p class="price">Custom</p>
      <p class="price-note">Annual contract for teams of 10 or more.</p>
      <a class="button ghost" href={sales}>Contact us</a>
      <p class="includes">Talk to us about:</p>
      <ul>
        <li>Shared team clipboards</li>
        <li>Single sign-on</li>
        <li>Admin controls and audit logs</li>
        <li>Blocking passwords and other secrets</li>
        <li>Your own retention rules</li>
        <li>Data processing agreements</li>
      </ul>
    </article>
  </section>

  <section class="band">
    <h2>Questions</h2>
    <details>
      <summary>How does the free trial work?</summary>
      <p>Your first 30 copies are free, with no card and no time limit. After that, you'll need a plan to copy new text. You can still paste, view, and delete your existing clips until they expire.</p>
    </details>
    <details>
      <summary>Is there a limit on clip size?</summary>
      <p>Up to about 1 MB per clip on every plan, which is roughly a million English characters.</p>
    </details>
    <details>
      <summary>When will Pro be available?</summary>
      <p>We're still building it. Join the waitlist and we'll email you when it's ready.</p>
    </details>
  </section>
</Layout>

<script>
  // Monthly is shown without JavaScript; the toggle appears once it can work.
  const toggle = document.querySelector<HTMLElement>('.billing-toggle');
  const plans = document.querySelector<HTMLElement>('.plans');
  if (toggle && plans) {
    toggle.hidden = false;
    toggle.querySelectorAll<HTMLButtonElement>('button').forEach((button) => {
      button.addEventListener('click', () => {
        plans.dataset.cycle = button.dataset.show;
        toggle.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      });
    });
  }
</script>
